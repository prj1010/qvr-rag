# Copy this file to .env and add your credentials.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b
NVIDIA_EMBEDDING_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_EMBEDDING_BATCH_SIZE=50

# Microsoft Foundry / Azure AI OpenAI v1-compatible endpoint for Phi models.
# Example: https://YOUR-RESOURCE.services.ai.azure.com/openai/v1
MICROSOFT_FOUNDRY_API_KEY=
MICROSOFT_FOUNDRY_BASE_URL=
MICROSOFT_FOUNDRY_MODEL=Phi-4-mini-instruct

# Docling local OCR for scanned/image-only PDFs. RapidOCR is used, so
# Tesseract is not required.
DOCLING_OCR_LANG=en

# Optional legacy cloud fallback. Keep disabled unless you explicitly need it.
DOCSTRANGE_FALLBACK_ENABLED=false
DOCSTRANGE_API_KEY=
# Override only if the provider changes its API host/path.
# DOCSTRANGE_API_URL=https://extraction-api.nanonets.com/api/v1/extract
# Legacy alias accepted by the adapter:
# NANONETS_API_KEY=

QUIVR_CHUNK_SIZE=1200
QUIVR_CHUNK_OVERLAP=150
# Olga parses native-text PDF, DOCX, XLSX, and HTML locally. Scanned PDFs use
# local Docling/RapidOCR; the optional cloud route is a last-resort fallback.
MAX_UPLOAD_FILES=10
MAX_UPLOAD_BYTES=20971520
MAX_UPLOAD_TOTAL_BYTES=52428800
MAX_PARSED_DOCUMENT_CHARS=5000000
MAX_PARSED_TOTAL_CHARS=10000000

# Use this for a self-hosted NVIDIA NIM:
# NVIDIA_BASE_URL=http://localhost:8000/v1
# NVIDIA_EMBEDDING_BASE_URL=http://localhost:8080/v1

MEMPALACE_PALACE_PATH=~/.mempalace/palace

# Admin observability: Microsoft Entra ID / Microsoft SSO.
# Register this callback URL in Entra ID:
# https://YOUR-RENDER-SERVICE.onrender.com/admin/callback
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
SESSION_SECRET=
ADMIN_EMAILS=admin@example.com
COOKIE_SECURE=false
# Temporary fallback for deployments where Microsoft SSO is not ready yet.
# Keep disabled in production once SSO is configured; never commit the token.
ADMIN_FALLBACK_ENABLED=false
ADMIN_FALLBACK_TOKEN=
ADMIN_FALLBACK_EMAIL=fallback-admin@local

# Optional open-source Langfuse tracing (self-hosted or Langfuse Cloud).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
OBSERVABILITY_CAPTURE_CONTENT=false

# Microsoft Agent Governance Toolkit fork. It is attached best-effort so a
# toolkit outage does not interrupt the chatbot. Set AGT_ENFORCEMENT_REQUIRED
# to true for strict fail-closed indexing when governance cannot initialize.
AGT_AGENT_ID=mempalace-quivr
AGT_COLLECTION=quivr-demo
AGT_ALLOWED_COLLECTIONS=quivr-demo
AGT_DENIED_COLLECTIONS=
AGT_MAX_RETRIEVALS_PER_MINUTE=60
AGT_RATE_LIMIT_WINDOW_SECONDS=60
AGT_CONTENT_POLICIES=block_pii,block_injections
AGT_AUDIT_ENABLED=true
AGT_ENFORCEMENT_REQUIRED=false
# Render should use /tmp/agent-rag-audit.jsonl; local Windows uses the app data folder by default.
# AGT_AUDIT_LOG_PATH=/tmp/agent-rag-audit.jsonl
AGENT_RAG_AUDIT_SALT=

# Optional cache location for the Kokoro model files.
# KOKORO_MODELS_DIR=C:\path\to\kokoro_models
# KOKORO_MODEL_URL=https://github.com/thewh1teagle/kokoro-onnx/releases/download/model-files-v1.0/kokoro-v1.0.onnx
# KOKORO_MODEL_FILENAME=kokoro-v1.0.onnx
# KOKORO_VOICES_URL=https://github.com/thewh1teagle/kokoro-onnx/releases/download/model-files-v1.0/voices-v1.0.bin
# KOKORO_VOICES_FILENAME=voices-v1.0.bin
